<mxfile host="Electron" agent="SmartMed">
  <diagram name="SmartMed Architecture Diagram" id="smartmed-arch">
    <mxGraphModel dx="900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#003296;fontSize=18;fontStyle=1;" value="SmartMed Pharmacy System&#xa;Layered Architecture (Single SmartMed Project)" vertex="1">
          <mxGeometry x="80" y="20" width="540" height="50" as="geometry" />
        </mxCell>

        <mxCell id="layer-pres" value="Presentation Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="layer-pres-body" value="Forms/ (WinForms UI)&#xa;&#xa;• LoginForm, RegistrationForm&#xa;• AdminShellForm + AdminDashboardForm&#xa;• ManageMedicinesForm, ManageCustomersForm&#xa;• ManageOrdersForm, ReportsForm" style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-pres">
          <mxGeometry y="34" width="540" height="246" as="geometry" />
        </mxCell>

        <mxCell id="arrow1" edge="1" parent="1" source="layer-pres" target="layer-biz" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="layer-biz" value="Business Logic Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="400" width="540" height="340" as="geometry" />
        </mxCell>
        <mxCell id="layer-biz-body" value="Services/ + Models/&#xa;&#xa;Models: Admin, Customer, Medicine, Order, OrderItem, Prescription&#xa;&#xa;Services (used selectively):&#xa;• AuthService — login &amp; registration&#xa;• MedicineService — medicine CRUD &amp; validation&#xa;• ReportService — sales/stock/history reports&#xa;• ValidationService, SearchService, Session&#xa;&#xa;Note: Orders and Customers forms call repositories directly." style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-biz">
          <mxGeometry y="34" width="540" height="306" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" edge="1" parent="1" source="layer-biz" target="layer-dal" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="layer-dal" value="Data Access Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="540" height="280" as="geometry" />
        </mxCell>
        <mxCell id="layer-dal-body" value="Data/ (Repositories + DatabaseHelper)&#xa;&#xa;• DatabaseHelper — ExecuteQuery / ExecuteNonQuery&#xa;• AdminRepository&#xa;• CustomerRepository&#xa;• MedicineRepository&#xa;• OrderRepository&#xa;&#xa;All SQL access goes through DatabaseHelper to SmartMedDB." style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-dal">
          <mxGeometry y="34" width="540" height="246" as="geometry" />
        </mxCell>

        <mxCell id="arrow3" edge="1" parent="1" source="layer-dal" target="db" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db" value="SQL Server&#xa;Database" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#003296;fontColor=#003296;fontSize=12;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="1090" width="100" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
