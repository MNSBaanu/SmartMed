<mxfile host="Electron" agent="SmartMed">
  <diagram name="SmartMed Architecture Diagram" id="smartmed-arch">
    <mxGraphModel dx="900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Helvetica;fontColor=#003296;fontSize=18;fontStyle=1;" value="SmartMed Pharmacy System&#xa;Presentation · Application · Data Layers" vertex="1">
          <mxGeometry x="30" y="20" width="560" height="50" as="geometry" />
        </mxCell>

        <mxCell id="layer-pres" value="Presentation Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="500" height="340" as="geometry" />
        </mxCell>
        <mxCell id="layer-pres-body" value="Forms/ — Windows Forms UI&#xa;&#xa;Shared&#xa;• LoginForm — Admin or Customer role login&#xa;• RegistrationForm — new customer sign-up&#xa;&#xa;Admin (implemented)&#xa;• AdminShellForm, AdminDashboardForm&#xa;• ManageMedicinesForm, ManageCustomersForm&#xa;• ManageOrdersForm, ReportsForm&#xa;&#xa;Customer (portal)&#xa;• CustomerDashboardForm — customer home&#xa;• SearchMedicinesForm — search by name, category, price&#xa;• PlaceOrderForm — cart and checkout&#xa;• TrackOrdersForm — view order status&#xa;• ProfileManagementForm — update profile details" style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-pres">
          <mxGeometry y="34" width="500" height="306" as="geometry" />
        </mxCell>

        <mxCell id="arrow1" edge="1" parent="1" source="layer-pres" target="layer-app" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="layer-app" value="Application Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="500" height="380" as="geometry" />
        </mxCell>
        <mxCell id="layer-app-body" value="Services/ + Models/ — business logic &amp; domain objects&#xa;&#xa;Models: Admin, Customer, Medicine, Order, OrderItem, Prescription&#xa;&#xa;Shared / Customer&#xa;• AuthService — AdminLogin, CustomerLogin, RegisterCustomer&#xa;• ValidationService — field and email validation&#xa;• Session — CurrentAdmin, CurrentCustomer&#xa;&#xa;Customer&#xa;• SearchService — filter medicines by name, category, price range&#xa;• MedicineService — browse/search medicines, stock &amp; expiry checks&#xa;• Order placement — validate stock, create order, reduce inventory&#xa;&#xa;Admin&#xa;• MedicineService — add, update, delete, export, print inventory&#xa;• ReportService — sales, stock, customer order history reports" style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-app">
          <mxGeometry y="34" width="500" height="346" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" edge="1" parent="1" source="layer-app" target="layer-data" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="layer-data" value="Data Layer" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=34;fillColor=#003296;fontColor=#ffffff;strokeColor=#003296;strokeWidth=1.5;html=1;collapsible=0;whiteSpace=wrap;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="layer-data-body" value="Data/ — data access via DatabaseHelper&#xa;&#xa;Shared&#xa;• DatabaseHelper — ExecuteQuery, ExecuteNonQuery, ExecuteScalar&#xa;&#xa;Customer&#xa;• CustomerRepository — register, login, profile CRUD, EmailExists&#xa;• OrderRepository — GetByCustomer, CreateOrder, GetItems (place &amp; track orders)&#xa;• MedicineRepository — search/read medicines for customer browsing&#xa;&#xa;Admin&#xa;• AdminRepository — admin login&#xa;• MedicineRepository — medicine CRUD&#xa;• OrderRepository — view all orders, update status, reports&#xa;• CustomerRepository — manage customer records" style="text;strokeColor=#003296;fillColor=#B4CBF9;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontFamily=Helvetica;fontColor=#003296;fontSize=11;html=1;whiteSpace=wrap;strokeWidth=1.5;" vertex="1" parent="layer-data">
          <mxGeometry y="34" width="500" height="266" as="geometry" />
        </mxCell>

        <mxCell id="arrow3" edge="1" parent="1" source="layer-data" target="db" style="endArrow=classic;html=1;strokeColor=#003296;strokeWidth=1.5;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db" value="SQL Server&#xa;SmartMedDB&#xa;(Admin, Customer, Medicine,&#xa;Order, OrderItem, Prescription)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffffff;strokeColor=#003296;fontColor=#003296;fontSize=11;fontStyle=1;fontFamily=Helvetica;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="260" y="1230" width="100" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
