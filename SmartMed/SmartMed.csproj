<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartMed.UI</RootNamespace>
    <AssemblyName>SmartMed</AssemblyName>
    <StartupObject>SmartMed.UI.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="ReaLTaiizor" Version="3.8.1.8" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>
  <!-- Stop a running debug session so the output exe is not locked during build. -->
  <Target Name="StopRunningSmartMed" BeforeTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name SmartMed -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;" IgnoreExitCode="true" />
  </Target>
  <!-- Remove Mark-of-the-Web after build (helps some Windows blocks; does not disable Smart App Control). -->
  <Target Name="UnblockBuiltExe" AfterTargets="Build" Condition="Exists('$(TargetPath)')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Unblock-File -LiteralPath '$(TargetPath)' -ErrorAction SilentlyContinue&quot;" />
  </Target>
  <ItemGroup>
    <None Include="Assets\Fonts\Roboto-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\Fonts\Roboto-Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Forms\AdminShellForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AdminShellForm.Designer.cs">
      <DependentUpon>AdminShellForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\AdminShellForm.resx">
      <DependentUpon>AdminShellForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ManageCustomersForm.cs" />
    <Compile Update="Forms\ManageCustomersForm.Designer.cs">
      <DependentUpon>ManageCustomersForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ManageCustomersForm.resx">
      <DependentUpon>ManageCustomersForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ManageMedicinesForm.cs" />
    <Compile Update="Forms\ManageMedicinesForm.Designer.cs">
      <DependentUpon>ManageMedicinesForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ManageMedicinesForm.resx">
      <DependentUpon>ManageMedicinesForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ManageOrdersForm.cs" />
    <Compile Update="Forms\ManageOrdersForm.Designer.cs">
      <DependentUpon>ManageOrdersForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ManageOrdersForm.resx">
      <DependentUpon>ManageOrdersForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\ReportsForm.cs" />
    <Compile Update="Forms\ReportsForm.Designer.cs">
      <DependentUpon>ReportsForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\ReportsForm.resx">
      <DependentUpon>ReportsForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\AdminHostForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AdminHostForm.Designer.cs">
      <DependentUpon>AdminHostForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AdminDashboardForm.cs" />
    <Compile Update="Forms\AdminDashboardForm.Designer.cs">
      <DependentUpon>AdminDashboardForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\LoginForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\LoginForm.Designer.cs">
      <DependentUpon>LoginForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\LoginForm.resx">
      <DependentUpon>LoginForm.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Forms\RegistrationForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\RegistrationForm.Designer.cs">
      <DependentUpon>RegistrationForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\CustomerHostForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CustomerHostForm.Designer.cs">
      <DependentUpon>CustomerHostForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\CustomerShellForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\CustomerShellForm.Designer.cs">
      <DependentUpon>CustomerShellForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Forms\CustomerShellForm.resx">
